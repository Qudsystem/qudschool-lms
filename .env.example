# Copy this file to .env.local for local development.
GEMINI_API_KEY=

# Use "/" for a custom domain. For project Pages, use "/<repository-name>/".
VITE_BASE_PATH=/

# Public site URL — used in canonical, sitemap, OG tags, JSON-LD.
# Update this once you register a domain, then update the same value in:
#   - public/robots.txt
#   - public/sitemap.xml
#   - public/llms.txt / llms-full.txt
#   - hooks/useSEO.ts
#   - index.html (JSON-LD @graph)
VITE_SITE_URL=https://qudschool.com

# === Analytics & Verification (optional — leave empty to skip) ===
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA4_ID=
# Set to "true" to enable GA4 events on localhost (for testing)
VITE_GA4_DEBUG=false
# Google Search Console verification (content="..." from meta tag)
VITE_GSC_VERIFICATION=
# Bing Webmaster Tools verification (content="..." from meta tag)
VITE_BING_VERIFICATION=
# Yandex Webmaster verification
VITE_YANDEX_VERIFICATION=
